<section class="py-12 text-center sm:py-20">
  <span class="inline-block rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700">
    Acortador de enlaces
  </span>
  <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
    Enlaces cortos, <span class="text-indigo-600">faciles de compartir</span>
  </h1>
  <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
    Convierte URLs largas en enlaces cortos y administra tus enlances en un solo lugar.
  </p>

  <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
    <% if user_signed_in? %>
      <%= link_to "Ver mis URLs", short_urls_path, class: "rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% else  %>
      <%= turbo_frame_tag "short_url_form", class: "w-full max-w-xl text-left" do %>
        <%= render partial: "short_urls/form" %>
      <% end %>
    <% end %>
  </div>
</section>

<section class="grid gap-4 sm:grid-cols-3">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="font-semibold text-slate-900">Rapido</h3>
    <p class="mt-2 text-sm text-slate-600">Pega tu enlace y obten una URL corta al instante.</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="font-semibold text-slate-900">Organizado</h3>
    <p class="mt-2 text-sm text-slate-600">Todos tus enlaces guardados en tu cuenta.</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="font-semibold text-slate-900">Seguro</h3>
    <p class="mt-2 text-sm text-slate-600">Solo tu puedes ver y administrar tus URLs.</p>
  </div>
</section>
