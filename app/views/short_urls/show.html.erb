<div class="mx-auto max-w-xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <a class="block break-all text-lg font-semibold text-indigo-600"><%= @short_url.original_url %></a>
  <p class="mt-2 text-sm text-slate-500">Valido hasta: <%= @short_url.expires_at%></p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <button class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 active:bg-indigo-700" onclick="navigator.clipboard.writeText('<%= short_url_link(@short_url) %>')"> Copiar Enlace</button>
    <%= button_to "Editar" , edit_short_url_path(@short_url.id),method: :get,
          class: "cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-100" if user_signed_in?%>
  </div>
</div>
