<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold text-slate-900">Mis Urls</h1>
  <%= button_to "Crea Nueva Url" , new_short_url_path,method: :get,
        class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @short_urls.each do |short_url| %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-indigo-300 hover:shadow-md">
      <h2 class="mb-2 truncate text-base font-semibold">
        <%= link_to truncate(short_url.original_url,length: 20), short_url, class: "text-indigo-600 hover:underline" %>
      </h2>
      <p class="text-xs text-slate-500"><%= short_url.expires_at.to_formatted_s(:long) %></p>
    </div>
  <% end %>
</div>
