<div class="mx-auto max-w-xl">
  <h1 class="mb-6 text-2xl font-bold text-slate-900">Agrega Url</h1>
  <%= turbo_frame_tag "short_url_form", target: (user_signed_in? ? "_top" : nil) do %>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <%= render partial:"form",locals: {short_url: @short_url }%>
    </div>
  <% end %>
</div>
