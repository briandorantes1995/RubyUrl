<%= turbo_frame_tag "short_url_form", class: "w-full max-w-xl text-left" do %>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-controller="clipboard">
    <h2 class="text-lg font-semibold text-slate-900">¡Tu URL corta está lista!</h2>

    <div class="mt-4 flex flex-col gap-2 sm:flex-row">
      <input type="text" readonly value="<%= short_url_link(@short_url) %>"
             data-clipboard-target="source"
             class="w-full flex-1 rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm font-medium text-indigo-600">
      <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
              class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 active:bg-indigo-700">
        Copiar
      </button>
    </div>

    <p class="mt-2 break-all text-xs text-slate-500">Destino: <%= @short_url.original_url %></p>

    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="alert">
      Este enlace solo es válido por 7 días (hasta el <%= @short_url.expires_at.strftime("%d/%m/%Y %H:%M") %>).
    </div>

    <div class="mt-6">
      <%= link_to "Crear otra URL", root_path, data: { turbo_frame: "_top" },
            class: "inline-block rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-100" %>
    </div>
  </div>
<% end %>
